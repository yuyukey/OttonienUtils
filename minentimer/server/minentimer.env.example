# Kopiere diese Datei nach minentimer.env und trag einen eigenen Schlüssel ein (mindestens 16 Zeichen),
# z. B. mit: openssl rand -base64 24
# Derselbe Schlüssel gehört beim Bauen der Mod in minentimer/sync-key.txt.
MINENTIMER_KEY=hier-einen-langen-zufaelligen-schluessel-eintragen
MINENTIMER_DATA=/var/lib/minentimer/data.json
MINENTIMER_HOST=127.0.0.1
MINENTIMER_PORT=8765
